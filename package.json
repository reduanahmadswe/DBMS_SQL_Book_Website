    "minisearch": "^7.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "sql.js": "^1.15.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@mdx-js/rollup": "^3.1.1",
    "@shikijs/rehype": "^4.6.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^27.0.1",
    "prettier": "^3.9.10",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
